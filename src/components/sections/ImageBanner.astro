---
import { Image } from 'astro:assets';
import grenoble from '../../assets/images/grenoble-hero.webp';
---

<div class="px-6 pb-12 lg:px-16 lg:pb-16">
  <Image
    src={grenoble}
    alt="Vue de Grenoble : l’Isère, ses quais et les montagnes enneigées"
    class="h-56 w-full rounded-xl object-cover object-[50%_40%] sm:h-72 lg:h-96"
  />
</div>
