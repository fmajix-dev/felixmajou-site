---
import SectionHeading from '../SectionHeading.astro';

const principles = [
  {
    title: 'Je comprends votre technologie.',
    text: 'Docteur en robotique, ancien élève de l'ENS Paris-Saclay, j'ai 20+ ans d'expérience dans la finance d’entreprise et de projet. Je parle aux investisseurs et aux banques dans leur langue, et à vos ingénieurs dans la leur. Quand un DAF classique demande une formation sur votre R&D, j’entre dans le sujet directement.',
  },
  {
    title: 'Je structure, je ne remplis pas des tableaux.',
    text: 'Business plan, levée de fonds, négociation bancaire, subventions et CIR — je conçois et j’exécute. Un copilote qui arbitre et anticipe, pas un prestataire qui attend des instructions.',
  },
  {
    title: 'Je vous donne mon avis, de manière directe et constructive.',
    text: 'Votre scénario optimiste repose sur trois hypothèses dont deux sont fragiles ? Vous l’entendrez. Un DAF utile est un DAF qui challenge, pas un DAF qui acquiesce.',
  },
  {
    title: 'Je m’adapte à votre rythme.',
    text: 'Temps partiel ou intérim, sur site ou à distance, engagement flexible. Vous accédez à 20+ ans d’expertise pour une fraction du coût d’un DAF temps plein.',
  },
];
---

<section id="approach" class="scroll-mt-6 border-b border-slate-100 px-6 py-14 lg:px-16 lg:py-16">
  <SectionHeading
    eyebrow="Mon approche"
    title="Ce que je vous apporte"
    description="Un copilote financier qui comprend vos enjeux techniques, qui structure et exécute en autonomie."
    class="mb-10"
  />

  <div class="grid gap-8 md:grid-cols-2">
    {
      principles.map((principle, index) => (
        <article>
          <div class="mb-5 flex items-center gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-blue-100 bg-blue-50 text-sm text-blue-600">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="h-px flex-1 bg-slate-100" />
          </div>
          <h3 class="mb-2 text-base font-medium">{principle.title}</h3>
          <p class="text-sm font-light leading-relaxed text-slate-500">{principle.text}</p>
        </article>
      ))
    }
  </div>
</section>
