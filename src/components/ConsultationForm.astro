---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../config/site';

const inputClass =
  'block w-full rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10';
---

<div id="consultation" class="relative scroll-mt-8">
  <div
    class="pointer-events-none absolute -right-8 -top-8 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-8 -left-8 h-56 w-56 rounded-full bg-indigo-500/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative rounded-xl border border-slate-200/80 bg-white p-6 shadow-xl shadow-slate-200/50 sm:p-8"
  >
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-xl font-medium tracking-tight">Prenons le temps d’échanger.</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">
          Présentez-moi votre contexte et vos sujets financiers pour organiser un échange de 30
          minutes.
        </p>
      </div>
    </div>

    <!-- Le formulaire prépare un e-mail (mailto) ; aucun envoi direct depuis le site. -->
    <form id="consultation-form" class="space-y-4" data-email={siteConfig.email}>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="space-y-1.5">
          <label for="name" class="block text-xs text-slate-700">
            Votre nom
            <span class="text-slate-400">*</span>
          </label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Camille Martin"
            required
            class={inputClass}
          />
        </div>
        <div class="space-y-1.5">
          <label for="company" class="block text-xs text-slate-700">
            Entreprise
            <span class="text-slate-400">*</span>
          </label>
          <input
            id="company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder="Votre entreprise"
            required
            class={inputClass}
          />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="email" class="block text-xs text-slate-700">
          E-mail professionnel
          <span class="text-slate-400">*</span>
        </label>
        <div class="relative">
          <Icon
            name="solar:letter-linear"
            size={17}
            class="pointer-events-none absolute left-3 top-3.5 text-slate-400"
            aria-hidden="true"
          />
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="camille@entreprise.fr"
            required
            class:list={[inputClass, 'pl-10']}
          />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="challenge" class="block text-xs text-slate-700">
          Quel est votre principal enjeu financier ?
        </label>
        <textarea
          id="challenge"
          name="challenge"
          rows="3"
          placeholder="Levée de fonds, financement BPI/ADEME, trésorerie, acquisition…"
          class:list={[inputClass, 'resize-y']}></textarea>
      </div>

      <button
        type="submit"
        class="flex w-full items-center justify-center gap-2 rounded-lg bg-blue-500 px-5 py-3 text-sm text-white shadow-xs transition-colors hover:bg-blue-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
      >
        Demander un rendez-vous
        <Icon name="solar:arrow-right-linear" size={17} aria-hidden="true" />
      </button>

      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="hidden rounded-lg border border-blue-100 bg-blue-50 p-3 text-xs leading-relaxed text-blue-700"
      >
      </p>
    </form>
  </div>
</div>

<script>
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;

    status.classList.remove('hidden');

    const businessEmail = form.dataset.email;
    if (!businessEmail) {
      status.textContent =
        'Ce formulaire n’est pas encore relié à une adresse e-mail. Vos informations n’ont pas été envoyées.';
      return;
    }

    const data = new FormData(form);
    const subject = `Demande de rendez-vous DAF — ${data.get('company')}`;
    const body = [
      `Nom : ${data.get('name')}`,
      `Entreprise : ${data.get('company')}`,
      `E-mail : ${data.get('email')}`,
      '',
      'Mon principal enjeu financier :',
      data.get('challenge') ||
        'Je souhaite échanger sur mon entreprise et mes priorités financières.',
      '',
      'J’accepte d’être recontacté au sujet de cette demande.',
    ].join('\n');

    window.location.href = `mailto:${businessEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    status.textContent = `Votre application de messagerie devrait s’ouvrir avec un e-mail préparé. Envoyez-le pour finaliser votre demande, ou écrivez directement à ${businessEmail}. Aucune information n’a été envoyée depuis cette page.`;
  });
</script>
